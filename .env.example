APP_NAME=order-system
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s
READINESS_TIMEOUT=2s
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SECURE_COOKIES=false
AUTH_RATE_WINDOW=1m
LOGIN_RATE_LIMIT=10
REFRESH_RATE_LIMIT=30
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_DURATION=30s
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=1m
# 默认使用 memory。需要 PostgreSQL 时取消下面两行的注释。
# STORAGE_DRIVER=postgres
# DATABASE_URL=postgres://order_system:order_system@127.0.0.1:5432/order_system?sslmode=disable
