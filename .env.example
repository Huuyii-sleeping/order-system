APP_NAME=order-system
HTTP_ADDR=:8080
# 留空时不采样也不导出 Trace；本地 Tempo 使用下面的地址。
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
SHUTDOWN_TIMEOUT=10s
# 标记 unready 后继续监听的短暂排水时间，让负载均衡器有机会摘除实例。
SHUTDOWN_DRAIN_DELAY=2s
READINESS_TIMEOUT=2s
# 默认不启用缓存；启用 Redis 后，商品详情缓存和认证入口限流由多个实例共享。
# CACHE_DRIVER=redis
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_KEY_PREFIX=order-system
CATALOG_CACHE_TTL=5m
CATALOG_NOT_FOUND_CACHE_TTL=15s
CATALOG_LOAD_TIMEOUT=2s
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SECURE_COOKIES=false
AUTH_RATE_WINDOW=1m
LOGIN_RATE_LIMIT=10
REFRESH_RATE_LIMIT=30
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_DURATION=30s
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=1m
PAYMENT_POLL_INTERVAL=1s
PAYMENT_BATCH_SIZE=10
PAYMENT_WORKER_CONCURRENCY=4
PAYMENT_LEASE_DURATION=30s
PAYMENT_RETRY_BASE=1s
PAYMENT_RETRY_MAX=1m
PAYMENT_PROVIDER_TIMEOUT=2s
PAYMENT_PROVIDER_MAX_CONCURRENT=4
PAYMENT_CIRCUIT_FAILURE_THRESHOLD=5
PAYMENT_CIRCUIT_OPEN_DURATION=30s
# 本地故障演练开关；默认关闭，真实 Provider 不应使用这两个配置。
SIMULATED_PAYMENT_DELAY=0s
SIMULATED_PAYMENT_FAILURES=0
NOTIFICATION_POLL_INTERVAL=1s
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_WORKER_CONCURRENCY=4
NOTIFICATION_LEASE_DURATION=30s
NOTIFICATION_RETRY_BASE=1s
NOTIFICATION_RETRY_MAX=1m
NOTIFICATION_PROVIDER_TIMEOUT=2s
# 本地通知故障演练开关；默认关闭，不访问真实通知 Provider。
SIMULATED_NOTIFICATION_DELAY=0s
SIMULATED_NOTIFICATION_FAILURES=0
SIMULATED_NOTIFICATION_REJECTIONS=0
# 默认使用进程内消息适配器。Kafka 模式必须同时使用 PostgreSQL。
# MESSAGE_DRIVER=kafka
# KAFKA_BROKERS=127.0.0.1:19092
# KAFKA_CONSUMER_GROUP=order-system-payments-v1
# KAFKA_DEAD_LETTER_TOPIC=orders.created.v1.dlq
# KAFKA_CONSUMER_MAX_ATTEMPTS=3
# KAFKA_CONSUMER_RETRY=1s
# 默认使用 memory。需要 PostgreSQL 时取消下面两行的注释。
# STORAGE_DRIVER=postgres
# DATABASE_URL=postgres://order_system:order_system@127.0.0.1:5432/order_system?sslmode=disable
